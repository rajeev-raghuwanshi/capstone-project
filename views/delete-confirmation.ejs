<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Confirm product deletion</title>
  </head>
  <body>
    <main>
      <h1>Delete product?</h1>
      <p>Confirm deletion of <strong><%= product.name %></strong>.</p>
      <form method="post" action="/products/<%= encodeURIComponent(product.id) %>/delete">
        <button type="submit">Confirm deletion</button>
        <a href="/products/<%= encodeURIComponent(product.id) %>">Cancel</a>
      </form>
    </main>
  </body>
</html>